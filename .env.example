# Supabase project URL and public anon/publishable JWT key (never service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exact canonical application origin; HTTPS required outside local development.
# Example: https://archives.example.com (no path, query, or trailing slash)
ARCHIVE_AUTH_ORIGIN=

# Optional canonical site URL for staging metadata, search and feeds.
# Defaults to the official archives domain when unset.
NEXT_PUBLIC_SITE_URL=
